diff --git a/bookmarks/tests/test_bookmark_visit_view.py b/bookmarks/tests/test_bookmark_visit_view.py
new file mode 100644
index 0000000..18e16bb
--- /dev/null
+++ b/bookmarks/tests/test_bookmark_visit_view.py
@@ -0,0 +1,104 @@
+import datetime
+
+from django.test import TestCase
+from django.urls import reverse
+from django.utils import timezone
+
+from bookmarks.models import BookmarkUsage
+from bookmarks.tests.helpers import BookmarkFactoryMixin
+
+
+class BookmarkVisitViewTestCase(TestCase, BookmarkFactoryMixin):
+    def setUp(self):
+        self.user = self.get_or_create_test_user()
+        self.bookmark = self.setup_bookmark(url="https://example.com/target")
+        self.visit_url = reverse("linkding:bookmarks.visit", args=[self.bookmark.id])
+
+    def test_requires_login(self):
+        response = self.client.get(self.visit_url)
+
+        self.assertRedirects(
+            response,
+            reverse("login") + f"?next={self.visit_url}",
+            fetch_redirect_response=False,
+        )
+        self.assertFalse(BookmarkUsage.objects.exists())
+
+    def test_private_bookmark_cannot_be_guessed(self):
+        other_user = self.setup_user(name="other")
+        other_user.profile.enable_usage_tracking = True
+        other_user.profile.save()
+        self.client.force_login(other_user)
+
+        response = self.client.get(self.visit_url)
+
+        self.assertEqual(response.status_code, 404)
+        self.assertFalse(BookmarkUsage.objects.exists())
+
+    def test_does_not_track_when_disabled(self):
+        self.client.force_login(self.user)
+
+        response = self.client.get(self.visit_url)
+
+        self.assertRedirects(
+            response, self.bookmark.url, fetch_redirect_response=False
+        )
+        self.assertFalse(BookmarkUsage.objects.exists())
+
+    def test_rejects_non_get_requests(self):
+        self.user.profile.enable_usage_tracking = True
+        self.user.profile.save()
+        self.client.force_login(self.user)
+
+        response = self.client.post(self.visit_url)
+
+        self.assertEqual(response.status_code, 405)
+        self.assertFalse(BookmarkUsage.objects.exists())
+
+    def test_atomically_increments_count_and_updates_last_accessed(self):
+        self.user.profile.enable_usage_tracking = True
+        self.user.profile.save()
+        self.client.force_login(self.user)
+
+        self.client.get(self.visit_url)
+        usage = BookmarkUsage.objects.get(bookmark=self.bookmark, user=self.user)
+        old_accessed = timezone.now() - datetime.timedelta(days=1)
+        BookmarkUsage.objects.filter(pk=usage.pk).update(last_accessed=old_accessed)
+
+        response = self.client.get(self.visit_url)
+
+        usage.refresh_from_db()
+        self.assertRedirects(
+            response, self.bookmark.url, fetch_redirect_response=False
+        )
+        self.assertEqual(usage.access_count, 2)
+        self.assertGreater(usage.last_accessed, old_accessed)
+
+    def test_tracks_shared_bookmark_separately_for_each_viewer(self):
+        self.user.profile.enable_sharing = True
+        self.user.profile.enable_usage_tracking = True
+        self.user.profile.save()
+        self.bookmark.shared = True
+        self.bookmark.save()
+        other_user = self.setup_user(name="other")
+        other_user.profile.enable_usage_tracking = True
+        other_user.profile.save()
+
+        self.client.force_login(self.user)
+        self.client.get(self.visit_url)
+        self.client.force_login(other_user)
+        self.client.get(self.visit_url)
+        self.client.get(self.visit_url)
+
+        self.assertEqual(
+            BookmarkUsage.objects.get(
+                bookmark=self.bookmark, user=self.user
+            ).access_count,
+            1,
+        )
+        self.assertEqual(
+            BookmarkUsage.objects.get(
+                bookmark=self.bookmark, user=other_user
+            ).access_count,
+            2,
+        )
